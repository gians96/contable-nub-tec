generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── ENUMS ──────────────────────────────────────────────

enum TipoMovimiento {
  VENTA
  COMPRA
}

enum TipoComprobante {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
  RECIBO_HONORARIOS
  TICKET
  OTRO
}

enum DestinoTributario {
  VENTA
  COSTO_VENTAS
  GASTO_ADMIN
  GASTO_VENTA
  ACTIVO_FIJO
  NO_DEDUCIBLE
}

enum Subcategoria {
  SAAS
  FACTURACION_ELECTRONICA
  HOSTING
  SOFTWARE
  CAMARAS
  PRODUCTO
  FLETE
  MOVILIDAD
  SERVIDOR
  INTERNET
  UTILES
  EQUIPO_PRUEBAS
  LICENCIA
  DOMINIO
  OTRO
}

enum RegimenTributario {
  NRUS
  RER
  RMT
  RG
}

/// Rol legado de usuario global. Sustituido por `User.platformRole` y
/// `Membership.role`; se elimina en una migración posterior para no perder la
/// vuelta atrás mientras el código nuevo se asienta.
enum UserRole {
  ADMIN
  USUARIO
}

/// Alcance de plataforma: un SUPERADMIN ve y administra todas las empresas.
enum PlatformRole {
  SUPERADMIN
  USER
}

/// Rol dentro de una empresa concreta.
enum CompanyRole {
  OWNER
  ADMIN
  CONTADOR
  LECTOR
}

enum CompanyEstado {
  ACTIVA
  SUSPENDIDA
}

enum PlanEmpresa {
  FREE
  PRO
}

enum AuditAccion {
  CREAR
  ACTUALIZAR
  ELIMINAR
}

enum RegimenIgv {
  GENERAL
  LEY_31556
  EXONERADO
  INAFECTO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  DEPOSITO
  CHEQUE
  OTRO
}

enum EstadoPago {
  PAGADO
  PENDIENTE
  PARCIAL
}

enum TipoDocumento {
  RUC
  DNI
  CE
  OTRO
}

enum CategoriaInventario {
  MERCADERIA
  SERVIDOR
  TICKETERA
  LECTOR
  LAPTOP
  IMPRESORA
  CAMARA
  OTRO_EQUIPO
}

enum EstadoCierre {
  EN_USO
  VENDIDO
  DADO_BAJA
  INVENTARIO_FINAL
}

// ─── PLATAFORMA ─────────────────────────────────────────

model User {
  id           Int          @id @default(autoincrement())
  username     String       @unique
  /// Alternativa al usuario para iniciar sesión. Nullable + unique: MySQL
  /// admite varios NULL, así que las cuentas sin correo no chocan entre sí.
  email        String?      @unique
  passwordHash String
  nombre       String?
  /// Contraseña temporal pendiente de cambiar (alta de miembro o seed inicial).
  debeCambiarPassword Boolean @default(false)
  /// Legado; se elimina cuando el rol por empresa lleve tiempo en producción.
  role         UserRole     @default(USUARIO)
  platformRole PlatformRole @default(USER)
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("users")
}

/// Empresa = tenant. Hereda la tabla `company_settings`, que era una fila única.
model Company {
  id              Int           @id @default(autoincrement())
  ruc             String        @default("")
  razonSocial     String        @default("")
  nombreComercial String?
  direccion       String?
  moneda          String        @default("PEN")
  estado          CompanyEstado @default(ACTIVA)
  plan            PlanEmpresa   @default(FREE)
  /// Cupos del plan. `null` = sin límite.
  limiteVouchersAnual Int?
  limiteUsuarios      Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships     Membership[]
  parties         Party[]
  vouchers        Voucher[]
  inventoryAssets InventoryAsset[]
  taxParameters   TaxParameter[]
  monthlySummaries MonthlySummary[]
  annualClosures  AnnualClosure[]
  auditLogs       AuditLog[]

  @@index([estado])
  @@map("companies")
}

/// Pertenencia de un usuario a una empresa, con su rol allí.
model Membership {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      CompanyRole @default(LECTOR)
  activo    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

/// Rastro de escrituras sobre datos contables.
model AuditLog {
  id        Int         @id @default(autoincrement())
  companyId Int
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  accion    AuditAccion
  entidad   String
  entidadId Int?
  resumen   String?
  /// JSON serializado a texto: evita depender del soporte de Json del adapter.
  datos     String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entidad, entidadId])
  @@map("audit_logs")
}

// ─── DATOS CONTABLES (por empresa) ──────────────────────

model TaxParameter {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  company             Company  @relation(fields: [companyId], references: [id])
  year                Int
  igvPercent          Decimal  @default(18.00) @db.Decimal(5, 2)
  irMonthlyPercent    Decimal  @default(1.00) @db.Decimal(5, 2)
  uit                 Decimal  @db.Decimal(10, 2)
  irAnnualTramo1Limit Decimal  @default(15) @db.Decimal(5, 2)
  irAnnualTramo1Rate  Decimal  @default(10.00) @db.Decimal(5, 2)
  irAnnualTramo2Rate  Decimal  @default(29.50) @db.Decimal(5, 2)
  irAnnualFlatRate    Decimal  @default(29.50) @db.Decimal(5, 2)

  // Régimen tributario vigente en el año y sus parámetros.
  regimen             RegimenTributario @default(RMT)

  // NRUS: cuota fija mensual segun categoria.
  nrusCategoria       Int      @default(1)
  nrusCuotaCat1       Decimal  @default(20.00) @db.Decimal(10, 2)
  nrusCuotaCat2       Decimal  @default(50.00) @db.Decimal(10, 2)
  nrusLimiteCat1      Decimal  @default(5000.00) @db.Decimal(12, 2)
  nrusLimiteCat2      Decimal  @default(8000.00) @db.Decimal(12, 2)

  // RER: tasa mensual de caracter definitivo.
  rerRate             Decimal  @default(1.50) @db.Decimal(5, 2)

  // RMT / RG: pago a cuenta.
  rmtUmbralUit        Decimal  @default(300) @db.Decimal(10, 2)
  rmtLimiteRegimenUit Decimal  @default(1700) @db.Decimal(10, 2)
  pagoCuentaMinRate   Decimal  @default(1.50) @db.Decimal(5, 2)
  coeficienteManual   Decimal? @db.Decimal(8, 6)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, year])
  @@map("tax_parameters")
}

model Party {
  id               Int           @id @default(autoincrement())
  companyId        Int
  company          Company       @relation(fields: [companyId], references: [id])
  tipoDocumento    TipoDocumento @default(RUC)
  numeroDocumento  String
  razonSocial      String
  direccion        String?
  email            String?
  telefono         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  vouchers Voucher[]

  @@unique([companyId, tipoDocumento, numeroDocumento])
  @@map("parties")
}

model Voucher {
  id                Int               @id @default(autoincrement())
  companyId         Int
  company           Company           @relation(fields: [companyId], references: [id])
  year              Int
  month             Int
  fecha             DateTime
  tipoMovimiento    TipoMovimiento
  tipoComprobante   TipoComprobante   @default(FACTURA)
  serie             String?
  numero            String?
  partyId           Int?
  party             Party?            @relation(fields: [partyId], references: [id])
  rucDni            String?
  razonSocial       String?
  afectoIgv         Boolean           @default(true)
  igvPercent        Decimal           @default(18.00) @db.Decimal(5, 2)
  regimenIgv        RegimenIgv        @default(GENERAL)
  importeTotal      Decimal           @db.Decimal(12, 2)
  baseImponible     Decimal           @db.Decimal(12, 2)
  igv               Decimal           @db.Decimal(12, 2)
  modoManual        Boolean           @default(false)
  medioPago         MedioPago         @default(TRANSFERENCIA)
  estadoPago        EstadoPago        @default(PAGADO)
  destinoTributario DestinoTributario
  subcategoria      Subcategoria      @default(OTRO)
  deducibleIr       Boolean           @default(true)
  creditoFiscalIgv  Boolean           @default(true)
  inventarioFinal   Boolean           @default(false)
  activoFijo        Boolean           @default(false)
  vidaUtilMeses     Int?
  observacion       String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  inventoryAssets InventoryAsset[]

  @@index([companyId, year, month])
  @@index([companyId, fecha])
  @@index([tipoMovimiento])
  @@index([destinoTributario])
  @@map("vouchers")
}

model InventoryAsset {
  id                Int                 @id @default(autoincrement())
  companyId         Int
  company           Company             @relation(fields: [companyId], references: [id])
  voucherId         Int?
  voucher           Voucher?            @relation(fields: [voucherId], references: [id])
  year              Int
  fecha             DateTime
  comprobante       String?
  descripcion       String
  categoria         CategoriaInventario @default(OTRO_EQUIPO)
  base              Decimal             @db.Decimal(12, 2)
  igv               Decimal             @db.Decimal(12, 2)
  total             Decimal             @db.Decimal(12, 2)
  igvPercent        Decimal             @default(18.00) @db.Decimal(5, 2)
  regimenIgv        RegimenIgv          @default(GENERAL)
  destinoTributario DestinoTributario   @default(GASTO_ADMIN)
  estadoCierre      EstadoCierre        @default(EN_USO)
  vidaUtilMeses     Int?
  depreciacionMensual Decimal?          @db.Decimal(12, 2)
  observaciones     String?             @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([companyId, year])
  @@map("inventory_assets")
}

model MonthlySummary {
  id                      Int      @id @default(autoincrement())
  companyId               Int
  company                 Company  @relation(fields: [companyId], references: [id])
  year                    Int
  month                   Int
  baseVentas              Decimal  @default(0) @db.Decimal(12, 2)
  igvVentas               Decimal  @default(0) @db.Decimal(12, 2)
  totalVentas             Decimal  @default(0) @db.Decimal(12, 2)
  baseComprasCreditoFiscal Decimal @default(0) @db.Decimal(12, 2)
  igvComprasCreditoFiscal Decimal  @default(0) @db.Decimal(12, 2)
  costoVentas             Decimal  @default(0) @db.Decimal(12, 2)
  gastoAdministracion     Decimal  @default(0) @db.Decimal(12, 2)
  gastoVentas             Decimal  @default(0) @db.Decimal(12, 2)
  activoFijo              Decimal  @default(0) @db.Decimal(12, 2)
  comprasNoDeducibles     Decimal  @default(0) @db.Decimal(12, 2)
  igvNetoMes              Decimal  @default(0) @db.Decimal(12, 2)
  saldoIgvMesAnterior     Decimal  @default(0) @db.Decimal(12, 2)
  saldoIgvMes             Decimal  @default(0) @db.Decimal(12, 2)
  pagoIrSugerido          Decimal  @default(0) @db.Decimal(12, 2)
  pagoIrEfectuado         Decimal  @default(0) @db.Decimal(12, 2)
  pagoIgvEfectuado        Decimal  @default(0) @db.Decimal(12, 2)
  pagoTotalSugerido       Decimal  @default(0) @db.Decimal(12, 2)
  pagoTotalEfectuado      Decimal  @default(0) @db.Decimal(12, 2)
  observaciones           String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([companyId, year, month])
  @@map("monthly_summaries")
}

model AnnualClosure {
  id                    Int      @id @default(autoincrement())
  companyId             Int
  company               Company  @relation(fields: [companyId], references: [id])
  year                  Int
  ventasNetas           Decimal  @default(0) @db.Decimal(12, 2)
  descuentos            Decimal  @default(0) @db.Decimal(12, 2)
  costoVentas           Decimal  @default(0) @db.Decimal(12, 2)
  gastosVentas          Decimal  @default(0) @db.Decimal(12, 2)
  gastosAdministracion  Decimal  @default(0) @db.Decimal(12, 2)
  otrosIngresos         Decimal  @default(0) @db.Decimal(12, 2)
  otrosGastos           Decimal  @default(0) @db.Decimal(12, 2)
  utilidadContable      Decimal  @default(0) @db.Decimal(12, 2)
  adiciones             Decimal  @default(0) @db.Decimal(12, 2)
  deducciones           Decimal  @default(0) @db.Decimal(12, 2)
  rentaNetaImponible    Decimal  @default(0) @db.Decimal(12, 2)
  pagosCuentaAcumulados Decimal  @default(0) @db.Decimal(12, 2)
  retenciones           Decimal  @default(0) @db.Decimal(12, 2)
  saldoFavorAnterior    Decimal  @default(0) @db.Decimal(12, 2)
  impuestoAnual         Decimal  @default(0) @db.Decimal(12, 2)
  saldoPorPagar         Decimal  @default(0) @db.Decimal(12, 2)
  saldoAFavor           Decimal  @default(0) @db.Decimal(12, 2)
  observaciones         String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, year])
  @@map("annual_closures")
}
